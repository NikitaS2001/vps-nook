networks:
  vpn_net:
    driver: bridge
    enable_ipv6: true
    ipam:
      config:
        - subnet: "{{ docker_network_subnet }}"
        - subnet: "{{ docker_network_ipv6_subnet | default('fd00:67:0:0::/64') }}"

services:
  wg-easy:
    image: ghcr.io/wg-easy/wg-easy:{{ wg_easy_version }}@{{ wg_easy_image_digest }}
    container_name: wg-easy
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
      - net.ipv6.conf.all.forwarding=1
    environment:
      # INSECURE=true serves the wg-easy UI over HTTP on 127.0.0.1. It is
      # reachable only via an SSH tunnel or through Caddy TLS over the VPN,
      # and the panel itself is password-protected by the INIT_* setup.
      INSECURE: "true"
      DISABLE_IPV6: "false"
{% if (wg_amnezia_enabled | default(false) | bool) %}
      # AmneziaWG is selected explicitly because the container cannot inspect
      # host kernel modules; the host module is asserted during preflight.
      EXPERIMENTAL_AWG: "true"
      OVERRIDE_AUTO_AWG: {{ wg_amnezia_overrided_executable | string | to_json }}
{% endif %}
{% if (wg_easy_include_init | default(false) | bool) %}
      # First-start only: wg-easy consumes the INIT_* variables during its
      # initial setup and ignores them afterwards. They are rendered only until
      # the WireGuard config exists so the panel password is not persisted here.
      INIT_ENABLED: "true"
      INIT_USERNAME: {{ wg_easy_admin_user | string | to_json }}
      INIT_PASSWORD: {{ (wg_easy_bootstrap_secret | replace('$', '$$')) | to_json }}
      INIT_HOST: {{ wg_public_host | string | to_json }}
      INIT_PORT: {{ wg_port | string | to_json }}
      INIT_DNS: {{ wg_client_dns | string | to_json }}
      INIT_IPV4_CIDR: {{ wg_vpn_subnet | default('10.8.0.0/24') | string | to_json }}
      INIT_IPV6_CIDR: {{ wg_vpn_ipv6_subnet | default('fd42:42:42::/64') | string | to_json }}
{% if (wg_traffic_mode | default('services')) == 'full' %}
      INIT_ALLOWED_IPS: "0.0.0.0/0{% if vps_orchestration_full_ipv6_enabled | default(false) | bool %},::/0{% endif %}"
{% else %}
      INIT_ALLOWED_IPS: {{ (wg_services_only_ipv4_destinations + wg_services_only_ipv6_destinations) | join(',') | to_json }}
{% endif %}
{% endif %}
    volumes:
      - "{{ project_root }}/volumes/wg-easy:/etc/wireguard"
    ports:
      - "{{ wg_port }}:{{ wg_container_port }}/udp"
      - "127.0.0.1:{{ wg_easy_bootstrap_ui_port }}:51821/tcp"
    healthcheck:
      disable: true
    networks:
      vpn_net:
        ipv4_address: "{{ wg_easy_container_ip }}"

  adguard:
    image: adguard/adguardhome:{{ adguard_version }}@{{ adguard_image_digest }}
    container_name: adguard
    restart: unless-stopped
    networks:
      vpn_net:
        ipv4_address: "{{ adguard_container_ip }}"
    ports:
      - "127.0.0.1:{{ adguard_bootstrap_ui_port }}:3000/tcp"
    volumes:
      - "{{ project_root }}/volumes/adguard/work:/opt/adguardhome/work"
      - "{{ project_root }}/volumes/adguard/conf:/opt/adguardhome/conf"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  caddy:
    image: caddy:{{ caddy_version }}@{{ caddy_image_digest }}
    container_name: caddy
    restart: unless-stopped
    networks:
      vpn_net:
        ipv4_address: "{{ caddy_container_ip }}"
    volumes:
      - "{{ project_root }}/volumes/caddy/data:/data"
      - "{{ project_root }}/volumes/caddy/config:/config"
      - "{{ project_root }}/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "{{ project_root }}/Caddyfile.d:/etc/caddy/Caddyfile.d:ro"
    healthcheck:
      # Caddy's local admin endpoint is enabled by default on 127.0.0.1:2019.
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:2019/config/ >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
