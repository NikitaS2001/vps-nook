---
# Network
wg_traffic_mode: "services"
ssh_port: 2222
wg_port: 51820
wg_container_port: 51820
wg_vpn_subnet: "10.8.0.0/24"
wg_server_ip: "10.8.0.1"
wg_client_dns: "10.66.0.2"

# wg-easy initial setup (Unattended Setup via INIT_* env vars, first start only)
# wg_public_host is required for remote deployment mode; the public installer
# auto-detects the public IP instead. All credential material comes from the
# encrypted vault file; plaintext password variables are rejected.
admin_password_hash: "{{ vault_admin_password_hash }}"
wg_easy_admin_user: "admin"
wg_easy_bootstrap_secret: "{{ vault_wg_easy_bootstrap_secret }}"
wg_public_host: ""
wg_allowed_ips:
  - "10.8.0.0/24"
  - "10.66.0.2/32"
  - "10.66.0.3/32"
# Docker network
docker_network_subnet: "10.66.0.0/24"
adguard_container_ip: "10.66.0.2"
caddy_container_ip: "10.66.0.3"
wg_easy_container_ip: "10.66.0.4"

# Internal domains. The suffix drives the AdGuard wildcard rewrite
# (*.<suffix> -> Caddy) and the derived defaults below (both overridable).
# Recommended: keep .internal (ICANN-reserved) or use .home.arpa (RFC 8375);
# avoid .local (mDNS) and unreserved suffixes such as .lan/.home.
internal_domain_suffix: "internal"
wg_internal_domain: "wg.{{ internal_domain_suffix }}"
adguard_internal_domain: "adguard.{{ internal_domain_suffix }}"

# Initial setup admin UI access through SSH local forwarding
wg_easy_bootstrap_ui_port: 51821
adguard_bootstrap_ui_port: 3000

# Remote host paths
project_root: "/opt/vps-nook"

# Pinned upstream installer artifacts
docker_apt_distribution: "{{ ansible_facts['distribution'] | lower }}"
docker_apt_release: "{{ ansible_facts['distribution_release'] }}"
docker_apt_arch_map:
  x86_64: amd64
docker_apt_arch: "{{ docker_apt_arch_map[ansible_facts['architecture']] | default(ansible_facts['architecture']) }}"
docker_apt_gpg_url: "https://download.docker.com/linux/{{ docker_apt_distribution }}/gpg"
docker_apt_repo_url: "https://download.docker.com/linux/{{ docker_apt_distribution }}"
docker_apt_gpg_checksum: "sha256:1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570"
ufw_docker_commit: "020a8699f95592561f254d8d4ad1bb40d401dfc7"
ufw_docker_checksum: "sha256:643e56b080567c567b4aa28650196849b2a2da5dd0473fd3e5216b0886035ab0"

# Package upgrade policy
vps_hardening_apply_package_upgrade: false
vps_hardening_package_upgrade_mode: "safe"

# Fail2Ban should not ignore the VPN subnet by default.
fail2ban_ignore_ips:
  - "127.0.0.1/8"
fail2ban_bantime: 3600
fail2ban_findtime: 600
fail2ban_maxretry: 5

# Admin user created by Ansible
admin_user: "sysadmin"
admin_shell: "/bin/bash"
ssh_service_name: "ssh"
# Use "yes" for OpenSSH 8.x compatibility. On OpenSSH 9.x, "local" can be used
# for stricter local-only forwarding.
ssh_allow_tcp_forwarding: "yes"

# Certificate fetch settings
root_ca_path_on_host: "{{ project_root }}/volumes/caddy/data/caddy/pki/authorities/local/root.crt"
fetched_certs_dir: "fetched_certs"
